ARG BASE_IMAGE=fluxvla:orin-base
FROM ${BASE_IMAGE}

ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
ARG UBUNTU_PORTS_MIRROR=

LABEL org.opencontainers.image.title="FluxVLA Orin ROS" \
      org.opencontainers.image.description="FluxVLA image with ROS Noetic for NVIDIA Jetson AGX Orin" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.vendor="Limx Dynamics" \
      com.limxdynamics.fluxvla.ros.enabled="1"

ENV FLUXVLA_INSTALL_ROS=1

COPY patch_rosconsole.py /tmp/patch_rosconsole.py

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libboost-all-dev libconsole-bridge-dev libpoco-dev libtinyxml2-dev \
      liblz4-dev libbz2-dev uuid-dev liblog4cxx-dev \
      libopencv-dev python3-opencv python3-empy python3-yaml python3-numpy \
      python3-defusedxml python3-netifaces liborocos-kdl-dev \
      liburdfdom-dev liburdfdom-headers-dev && \
    pip3 install rosdep rosinstall_generator vcstool catkin_pkg rospkg empy==3.3.4 pycryptodomex python-gnupg && \
    mkdir -p /opt/rosdistro && \
    for attempt in 1 2 3 4 5; do \
      curl -fsSL --retry 5 --retry-delay 2 --connect-timeout 20 \
        https://codeload.github.com/ros/rosdistro/tar.gz/master \
        -o /tmp/rosdistro.tar.gz && break; \
      if [ "$attempt" = "5" ]; then exit 1; fi; \
      echo "rosdistro download failed, retrying (${attempt}/5)"; \
    done && \
    tar -xzf /tmp/rosdistro.tar.gz -C /opt/rosdistro --strip-components=1 && \
    export ROSDISTRO_INDEX_URL=file:///opt/rosdistro/index-v4.yaml && \
    mkdir -p /etc/ros/rosdep/sources.list.d && \
    { \
      echo 'yaml file:///opt/rosdistro/rosdep/base.yaml'; \
      echo 'yaml file:///opt/rosdistro/rosdep/python.yaml'; \
      echo 'yaml file:///opt/rosdistro/rosdep/ruby.yaml'; \
    } > /etc/ros/rosdep/sources.list.d/20-default.list && \
    for attempt in 1 2 3 4 5; do \
      rosdep update --rosdistro noetic --include-eol-distros && break; \
      if [ "$attempt" = "5" ]; then exit 1; fi; \
      echo "rosdep update failed, retrying (${attempt}/5)"; \
    done && \
    mkdir -p /opt/ros_noetic_ws/src && \
    cd /opt/ros_noetic_ws && \
    for attempt in 1 2 3 4 5; do \
      rosinstall_generator ros_comm common_msgs vision_opencv \
        --rosdistro noetic --deps --tar > noetic-fluxvla.rosinstall.tmp && \
        mv noetic-fluxvla.rosinstall.tmp noetic-fluxvla.rosinstall && break; \
      rm -f noetic-fluxvla.rosinstall.tmp; \
      if [ "$attempt" = "5" ]; then exit 1; fi; \
      echo "rosinstall_generator failed, retrying (${attempt}/5)"; \
    done && \
    python3 -c "import re; from pathlib import Path; path = Path('noetic-fluxvla.rosinstall'); s = path.read_text(); s = re.sub(r'https://github\.com/([^/]+)/([^/]+)/archive/(.+?)\.tar\.gz', r'https://codeload.github.com/\1/\2/tar.gz/\3', s); path.write_text(s)" && \
    rm -rf src && mkdir -p src && \
    for attempt in 1 2 3 4 5; do \
      vcs import --workers 1 --retry 5 --skip-existing --input noetic-fluxvla.rosinstall src && break; \
      if [ "$attempt" = "5" ]; then exit 1; fi; \
      echo "vcs import failed, retrying (${attempt}/5)"; \
    done && \
    python3 /tmp/patch_rosconsole.py && \
    apt-get update && \
    rosdep install --from-paths src --ignore-packages-from-source \
      --rosdistro noetic --os=ubuntu:jammy --skip-keys "catkin_pkg python3-catkin-pkg-modules python3-rosdep-modules" -y && \
    ./src/catkin/bin/catkin_make_isolated --install \
      --install-space /opt/ros/noetic \
      -DCMAKE_BUILD_TYPE=Release \
      -DPYTHON_EXECUTABLE=/usr/bin/python3 && \
    rm -rf /opt/ros_noetic_ws/build_isolated \
           /opt/ros_noetic_ws/devel_isolated \
           /root/.ros/rosdep/sources.cache \
           /var/lib/apt/lists/* \
           /var/cache/apt/archives/*.deb && \
    rm -f /tmp/patch_rosconsole.py

RUN . /opt/ros/noetic/setup.sh && \
    python3 - <<'PY'
import importlib
mods = [
    'rospy', 'cv_bridge', 'sensor_msgs.msg', 'geometry_msgs.msg',
    'nav_msgs.msg', 'std_msgs.msg', 'rosbag', 'Cryptodome.Cipher', 'gnupg',
]
for name in mods:
    mod = importlib.import_module(name)
    print(f'{name}: {getattr(mod, "__version__", "ok")}')
PY

COPY ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["/bin/bash"]