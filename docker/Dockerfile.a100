# =============================================================================
# FluxVLA A100 -- full environment for training, evaluation & inference
#
# Reproduces the complete fluxvla development environment on A100 GPUs.
# Includes all dependencies: LIBERO, MuJoCo, TensorFlow, wandb, etc.
#
# Build:
#   docker build -f docker/Dockerfile.a100 -t fluxvla-a100 .
#
# Train:
#   docker run --gpus all --shm-size=64g \
#     -v ./checkpoints:/app/checkpoints \
#     -v ./datasets:/app/datasets \
#     -v ./work_dirs:/app/work_dirs \
#     fluxvla-a100 torchrun --standalone --nnodes 1 --nproc-per-node 8 \
#       scripts/train.py \
#       --config configs/pi05/pi05_paligemma_libero_10_full_finetune.py \
#       --work-dir ./work_dirs/pi05
#
# Eval:
#   docker run --gpus all --shm-size=64g \
#     -v ./checkpoints:/app/checkpoints \
#     -v ./work_dirs:/app/work_dirs \
#     fluxvla-a100 torchrun --standalone --nnodes 1 --nproc-per-node 2 \
#       scripts/eval.py \
#       --config configs/pi05/pi05_paligemma_libero_10_full_finetune.py \
#       --ckpt-path checkpoints/model.safetensors
#
# Serve (ZMQ inference server):
#   docker run --gpus all -p 5555:5555 \
#     -v ./checkpoints:/app/checkpoints \
#     fluxvla-a100 python -m fluxvla.engines.runners.serving.serve \
#       --config configs/pi05/pi05_paligemma_aloha_remote_inference.py \
#       --ckpt-path checkpoints/model.safetensors
# =============================================================================

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# ---- System packages ----
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-dev python3.10-venv python3-pip \
        git ninja-build cmake \
        libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
        libegl-dev libgl1-mesa-dev libx11-dev libglew-dev libosmesa6-dev \
        wget curl ca-certificates \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# ---- PyTorch + CUDA 12.4 ----
RUN pip install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
    --index-url https://download.pytorch.org/whl/cu124

# ---- flash-attn ----
RUN pip install --no-cache-dir psutil ninja packaging && \
    MAX_JOBS=8 pip install --no-cache-dir --no-build-isolation \
    flash-attn==2.5.5 \
    --find-links https://github.com/Dao-AILab/flash-attention/releases

# ---- av (conda-forge wheel via pip for Docker) ----
RUN pip install --no-cache-dir av==14.4.0 || \
    pip install --no-cache-dir av

# ---- requirements.txt (full, except editable git deps) ----
# Install non-editable deps first for better layer caching
RUN pip install --no-cache-dir \
    accelerate==0.33.0 \
    bddl==1.0.1 \
    boto3==1.38.32 \
    botocore==1.38.32 \
    cloudpickle \
    datasets==4.0.0 \
    diffusers==0.30.2 \
    draccus==0.10.0 \
    easydict==1.9 \
    einops==0.4.1 \
    future==0.18.2 \
    gcsfs \
    gym==0.25.2 \
    hydra-core==1.2.0 \
    imageio \
    imageio-ffmpeg==0.6.0 \
    jsonlines==4.0.0 \
    matplotlib \
    mmengine==0.10.7 \
    mujoco==3.3.2 \
    numpy==1.26.4 \
    opencv-python \
    peft==0.11.1 \
    robomimic==0.2.0 \
    robosuite==1.4.1 \
    sentencepiece==0.1.99 \
    sentry-sdk==2.27.0 \
    tensorflow==2.15.0 \
    tensorflow-graphics \
    "thop==0.1.1-2209072238" \
    timm==0.9.10 \
    tqdm-loggable==0.2 \
    transformers==4.53.2 \
    types-boto3-s3==1.38.26 \
    wandb==0.21.0 \
    msgpack \
    pyzmq \
    safetensors \
    pre-commit

# ---- Editable git dependencies ----
RUN pip install --no-cache-dir -e "git+https://github.com/kvablack/dlimp#egg=dlimp"
RUN pip install --no-cache-dir -e "git+https://github.com/yinchimaoliang/LIBERO.git#egg=libero"

# Pin numpy back (some deps may overwrite it)
RUN pip install --no-cache-dir numpy==1.26.4

WORKDIR /app

# ---- Copy project source ----
COPY . /app/

# ---- Build CUDA extensions (A100 = SM 8.0) ----
ENV FORCE_CUDA=1
ENV TORCH_CUDA_ARCH_LIST="8.0"
RUN pip install --no-build-isolation -e .

# ---- EGL config for headless LIBERO eval ----
RUN mkdir -p /usr/share/glvnd/egl_vendor.d && \
    echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' \
    > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# ---- Environment ----
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV MUJOCO_GL=egl
ENV NVIDIA_DRIVER_CAPABILITIES=all

EXPOSE 5555

CMD ["bash"]
