ARG BASE_IMAGE=fluxvla:orin-fa
ARG ROS_IMAGE=fluxvla:orin-ros
FROM ${ROS_IMAGE} AS ros_layer

FROM ${BASE_IMAGE}
ARG BASE_IMAGE

ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="FluxVLA Orin ROS + FlashAttention" \
      org.opencontainers.image.description="FluxVLA image with ROS Noetic and flash-attn 2.5.5 SM87 for NVIDIA Jetson AGX Orin" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.vendor="Limx Dynamics" \
      com.limxdynamics.fluxvla.ros.enabled="1"

ENV FLUXVLA_INSTALL_ROS=1

# Populate ROS installation from the separately built ROS image.
COPY --from=ros_layer /opt/ros/noetic /opt/ros/noetic
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/catkin_pkg /usr/local/lib/python3.10/dist-packages/catkin_pkg
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/catkin_pkg_modules-* /usr/local/lib/python3.10/dist-packages/
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/rospkg /usr/local/lib/python3.10/dist-packages/rospkg
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/rospkg-* /usr/local/lib/python3.10/dist-packages/
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/rosdistro /usr/local/lib/python3.10/dist-packages/rosdistro
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/rosdistro-* /usr/local/lib/python3.10/dist-packages/
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/docutils /usr/local/lib/python3.10/dist-packages/docutils
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/docutils-* /usr/local/lib/python3.10/dist-packages/
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/distro /usr/local/lib/python3.10/dist-packages/distro
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/distro-* /usr/local/lib/python3.10/dist-packages/
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/gnupg.py /usr/local/lib/python3.10/dist-packages/gnupg.py
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/python_gnupg-* /usr/local/lib/python3.10/dist-packages/
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/Cryptodome /usr/local/lib/python3.10/dist-packages/Cryptodome
COPY --from=ros_layer /usr/local/lib/python3.10/dist-packages/pycryptodomex-* /usr/local/lib/python3.10/dist-packages/

# Runtime dependencies for cv_bridge_boost.so copied from the ROS layer.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libboost-python1.74.0 \
        libboost-regex1.74.0 && \
    rm -rf /var/lib/apt/lists/*

RUN . /opt/ros/noetic/setup.sh && \
    python3 - <<'PY'
import importlib
mods = [
    'flash_attn', 'flash_attn.flash_attn_interface', 'flash_attn_2_cuda',
    'rospy', 'cv_bridge', 'sensor_msgs.msg', 'geometry_msgs.msg',
    'nav_msgs.msg', 'std_msgs.msg', 'rosbag', 'Cryptodome.Cipher', 'gnupg',
]
for name in mods:
    mod = importlib.import_module(name)
    print(f'{name}: {getattr(mod, "__version__", "ok")}')
from cv_bridge.boost.cv_bridge_boost import getCvType
print(f'cv_bridge boost rgb8: {getCvType("rgb8")}')
PY

COPY ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["/bin/bash"]
